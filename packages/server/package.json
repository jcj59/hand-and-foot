{
  "name": "@hf/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --coverage.provider=v8"
  },
  "dependencies": {
    "@hf/engine": "workspace:*",
    "@hf/shared": "workspace:*",
    "postgres": "^3.4.7",
    "socket.io": "^4.8.3",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^5.0.2",
    "socket.io-client": "^4.8.3",
    "typescript": "^5.7.2",
    "vitest": "^5.0.2"
  }
}
